# TradeVault Environment Variables
# Copy this to .env.local and fill in your values

# ─────────────────────────────────────────────────────────────
# SUPABASE (Required)
# Get these from your Supabase project dashboard:
# https://app.supabase.com → Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - for server-side admin operations only
# NEVER expose this in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────────────────────
# AI (Optional - app works without this)
# Only needed if user enables AI Review with external provider
# Stored server-side only, never exposed to browser
# ─────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────
# App URL (Required for Vercel deployment)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
